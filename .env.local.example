# URL de l'API Supabase locale (port 54421, voir supabase/config.toml). Après
# `npx supabase start`, reprends la valeur "API URL" affichée par la CLI
# (http://127.0.0.1:54421 en local).
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (anon) du projet Supabase local, affichée par `npx supabase start`
# (ou `npx supabase status`). Exposée au client (NEXT_PUBLIC_*) : toute la sécurité
# repose sur les policies RLS, jamais sur le secret de cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role, affichée par `npx supabase start`/`status`. Bypass RLS entièrement :
# variable serveur uniquement (jamais NEXT_PUBLIC_*). N'est utilisée aujourd'hui que par
# les tests e2e (tests/e2e/helpers.ts) pour poser des fixtures que l'UI ne permet pas
# encore de créer (ex. une membership, en l'absence d'UI d'invitation dans cette
# branche). Ne jamais utiliser cette clé dans du code exécuté côté client.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app, utilisée pour construire les liens de redirection OAuth/email.
# 3100 (pas 3000) : ce port est déjà pris par un autre projet sur ce poste, voir
# `npm run dev` dans package.json et le README.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Réservé aux tests e2e locaux/CI : active la porte de connexion par mot de
# passe /e2e-login. Variable serveur uniquement (jamais NEXT_PUBLIC_*, qui
# serait inlinée dans le build). NE JAMAIS positionner en production.
# E2E_ENABLED=1
